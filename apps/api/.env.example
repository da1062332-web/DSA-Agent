# apps/api/.env.example — Local API environment variables template.
# Placeholders only — never commit real secrets or credentials.

NODE_ENV=development
PORT=3000
LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The API connects as dsa_api (member of dsa_app, NOBYPASSRLS)
# Local Supabase: port 54322. Hosted: Supavisor transaction pooler, port 6543
DATABASE_URL=postgresql://dsa_api:<password>@127.0.0.1:54322/postgres

# Migration verification (connects as postgres for RLS lint and grant checks)
VERIFY_DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:54322/postgres

# Direct connection (port 5432) for running migrations
DIRECT_DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:54322/postgres

# Supabase Auth configuration
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_JWT_SECRET=<local-jwt-secret>
TEST_TOKENS=false

# Port selection (noop | fake | real)
PORT_RULES_SEEDER=noop
