# Copy to apps/web/.env. Only these three variables are read (TASK-001 §10).
# The browser holds the publishable (anon) key only — never a service_role or secret key.
# Shared hosted development project (DSA-Agent). A URL is not a secret. For the local stack use http://127.0.0.1:54321.
VITE_SUPABASE_URL=https://mlpkwwhnagxzinaohdxg.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key-from-supabase-status>
VITE_API_BASE_URL=http://localhost:3000

# Local development and tests only. Shows the fixed-code test sign-in (VITE_TEST_BYPASS_OTP, 000000 by default).
# Ignored in production builds. The API must also run with TEST_AUTH_ENABLED=true (apps/api/.env.example).
# VITE_TEST_AUTH=true
# VITE_DISABLE_MFA=true skips the authenticator step in a test build only; the API must run with DISABLE_MFA=true as well.
