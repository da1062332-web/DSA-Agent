{
  "name": "@dsa/tools",
  "version": "0.0.0",
  "private": true,
  "description": "Repository tools: OpenAPI generation, migration verification, tenant provisioning, test tokens, BRE registry SQL.",
  "type": "module",
  "scripts": {
    "gen:openapi": "tsx gen-openapi.ts",
    "verify:migrations": "tsx verify-migrations.ts",
    "provision:tenant": "tsx --env-file-if-exists=../.env provision-tenant.ts",
    "test-token": "tsx --env-file-if-exists=../.env test-token.ts",
    "gen:registry-sql": "tsx gen-registry-sql.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dsa/api": "*",
    "@dsa/contracts": "*",
    "pg": "^8.13.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
