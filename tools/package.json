{
  "name": "@dsa/tools",
  "version": "0.0.0",
  "private": true,
  "description": "Repository tools: OpenAPI generation, migration verification, tenant provisioning, test tokens, BRE registry SQL.",
  "type": "module",
  "scripts": {
    "gen:openapi": "tsx gen-openapi.ts",
    "verify:migrations": "tsx --env-file-if-exists=../apps/api/.env verify-migrations.ts",
    "provision:tenant": "tsx --env-file-if-exists=../apps/api/.env provision-tenant.ts",
    "provision:platform-admin": "tsx --env-file-if-exists=../apps/api/.env provision-platform-admin.ts",
    "provisioning:worker": "tsx --env-file-if-exists=../apps/api/.env.provisioning provisioning-worker.ts",
    "provisioning:worker:local": "tsx --env-file-if-exists=../apps/api/.env --env-file-if-exists=../apps/api/.env.provisioning provisioning-worker.ts",
    "identity:inventory": "tsx --env-file-if-exists=../apps/api/.env.provisioning identity-binding.ts inventory",
    "identity:bind": "tsx --env-file-if-exists=../apps/api/.env.provisioning identity-binding.ts bind",
    "seed:local-flow": "tsx seed-local-flow.ts",
    "test-token": "tsx --env-file-if-exists=../apps/api/.env test-token.ts",
    "gen:registry-sql": "tsx gen-registry-sql.ts",
    "check:migrations": "tsx check-migrations-immutable.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dsa/api": "*",
    "@dsa/contracts": "*",
    "@dsa/kernel": "*",
    "@supabase/supabase-js": "^2.117.3",
    "pg": "^8.13.1",
    "ulid": "^2.4.0",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
