# Copy to .env for local development. Placeholders only — never commit real values (Contracts §14).
# Other lanes append their variables by PR (Dev 1 owns this file).

# ---- API (apps/api) ----
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated browser origins allowed by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:5173

# The API connects as dsa_api (member of dsa_app, NOBYPASSRLS) — never as postgres or service_role (ADR-SB-03).
# Hosted Supabase only: Supavisor transaction mode, user dsa_api.<project-ref>, port 6543.
# dsa_api is created outside migrations (Migration Plan §0, REL-001).
DATABASE_URL=postgresql://dsa_api:<password>@<pooler-host>:6543/postgres

# Supabase Auth (TASK-102 verifies tokens against <SUPABASE_URL>/auth/v1/.well-known/jwks.json).
SUPABASE_URL=https://<project-ref>.supabase.co
# Legacy HS256 secret: server-side only, local stack only.
SUPABASE_JWT_SECRET=<local-jwt-secret-from-supabase-status>
# Integration tests only. The API refuses to start if this is true while SUPABASE_URL is a hosted project.
TEST_TOKENS=false

# Port selection (fake | real | noop). Owners switch their port to `real` at integration.
PORT_RULES_SEEDER=noop

# ---- Tools only (tools/provision-tenant.ts). Never in the API runtime or the web bundle. ----
SUPABASE_SERVICE_ROLE_KEY=<service-role-key-tools-only>
# Optional: password for every demo user (12+ characters). If unset, provision-tenant generates one and prints it.
DEMO_USER_PASSWORD=
